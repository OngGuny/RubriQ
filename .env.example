# --- LLM ---
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# --- Langfuse (docker compose up 후 http://localhost:3001 에서 발급) ---
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=http://localhost:3001

# --- pgvector (앵커 에세이 검색) ---
DATABASE_URL=postgresql://rubriq:rubriq@localhost:5432/rubriq

# --- 호스트 포트 (다른 프로젝트와 충돌 시에만 변경) ---
LANGFUSE_PORT=3001
POSTGRES_PORT=5432

# --- 채점 설정 ---
RUBRIQ_MAX_REGRADE_LOOPS=2
RUBRIQ_REGRESSION_QWK_THRESHOLD=0.60
