# --- LLM ---
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# --- Langfuse (compose 기동 시 헤드리스로 자동 생성되는 로컬 전용 키) ---
LANGFUSE_PUBLIC_KEY=pk-lf-rubriq-local
LANGFUSE_SECRET_KEY=sk-lf-rubriq-local
LANGFUSE_HOST=http://localhost:3001

# --- pgvector (앵커 에세이 검색) ---
DATABASE_URL=postgresql://rubriq:rubriq@localhost:5432/rubriq

# --- 호스트 포트 (다른 프로젝트와 충돌 시에만 변경) ---
LANGFUSE_PORT=3001
POSTGRES_PORT=5432

# --- 채점 설정 ---
RUBRIQ_MAX_REGRADE_LOOPS=2
RUBRIQ_REGRESSION_QWK_THRESHOLD=0.60
